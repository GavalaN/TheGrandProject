<Window x:Class="AAAdminApp.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Car Listing" Height="700" Width="800"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Basic Information Section -->
            <TextBlock Text="Általános infó" Grid.Row="0" Grid.ColumnSpan="2" 
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Márka ID:" Grid.Row="1" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtBrandId" Text="{Binding BrandId}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Típus ID:" Grid.Row="2" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtTypeId" Text="{Binding TypeId}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Leirás:" Grid.Row="3" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtDescription" Text="{Binding Description}" Grid.Row="3" Grid.Column="1" 
                     Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"/>

            <!-- Technical Specifications Section -->
            <TextBlock Text="Technikai specifikáció" Grid.Row="4" Grid.ColumnSpan="2" 
                       FontWeight="Bold" FontSize="14" Margin="0,10,0,10"/>

            <TextBlock Text="Kilóméteróra (km):" Grid.Row="5" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtKmClock" Text="{Binding KmClock}" Grid.Row="5" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Szín ID:" Grid.Row="6" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtColorId" Text="{Binding ColorId}" Grid.Row="6" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Ár:" Grid.Row="7" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtPrice" Text="{Binding Price}" Grid.Row="7" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Kivitel:" Grid.Row="8" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtBodyType" Text="{Binding BodyType}" Grid.Row="8" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Hengerek száma:" Grid.Row="9" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtNumOfCyl" Text="{Binding NumOfCyl}" Grid.Row="9" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Lóerő:" Grid.Row="10" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtHorsepower" Text="{Binding Horsepower}" Grid.Row="10" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Motor méret(ccm):" Grid.Row="11" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtCc" Text="{Binding Cc}" Grid.Row="11" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Motor típus:" Grid.Row="12" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtEngineType" Text="{Binding EngineType}" Grid.Row="12" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Üzemanyag:" Grid.Row="13" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtFuelType" Text="{Binding FuelType}" Grid.Row="13" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Hajtás:" Grid.Row="14" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtDrive" Text="{Binding Drive}" Grid.Row="14" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Váltó típus:" Grid.Row="15" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtTransType" Text="{Binding TransType}" Grid.Row="15" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Évjárat:" Grid.Row="16" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtYear" Text="{Binding Year}" Grid.Row="16" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Súly (kg):" Grid.Row="17" Grid.Column="0" Margin="0,0,10,5"/>
            <TextBox x:Name="txtKWeight" Text="{Binding KWeight}" Grid.Row="17" Grid.Column="1" Margin="0,0,0,5"/>

            <TextBlock Text="Eladva-e:" Grid.Row="18" Grid.Column="0" Margin="0,0,10,5"/>
            <CheckBox x:Name="chkSold" IsChecked="{Binding Sold}" Grid.Row="18" Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,0,5"/>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="19" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Button x:Name="btnSave" Content="Mentés" Width="80" Margin="0,0,10,0" Click="btnSave_Click"/>
                <Button x:Name="btnCancel" Content="Vissza" Width="80" Click="btnCancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>